      "link_text.hover": "#9c3b00"
    }
  },

  /* ==========================================================
     UI COMPONENT & LAYOUT SETTINGS
     ========================================================== */
  "title_bar": {
    "show_branch_name": false,
    "show_user_menu": false
  },
  "tab_bar": {
    "show": false
  },
  "toolbar": {
    "quick_actions": false,
    "breadcrumbs": false
  },
  "scrollbar": {
    "show": "never"
  },
  "gutter": {
    "min_line_number_digits": 0,
    "folds": false
  },
  "indent_guides": {
    "enabled": false
  },
  "terminal": {
    "font_weight": 400.0,
    // "font_family": "JetBrains Mono",
    "dock": "right",
    "default_width": 300
  },

  /* ==========================================================
     LANGUAGE SERVER PROTOCOL (LSP) CONFIGURATION
     ========================================================== */
  "lsp": {
    "clangd": {
      "binary": {
        "arguments": [
          "--query-driver=C:\\MinGW\\bin\\gcc.exe",
          "--fallback-flags=-IC:\\MinGW\\include -IC:\\MinGW\\lib\\gcc\\mingw32\\*\\include"
        ]
      }
    }
  }
}
