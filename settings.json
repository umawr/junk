{
  /* ==========================================================
     GLOBAL EDITOR PREFERENCES
     ========================================================== */
  "tab_size": 2,
  "markdown_preview": {
    "heading_font_weight": 450.0
  },
  "cli_default_open_behavior": "existing_window",
  "buffer_font_weight": 400.0,
  "buffer_line_height": "comfortable",
  "agent_ui_font_size": 10.0,
  "ui_font_weight": 400.0,
  "status_bar": {
    "experimental.show": false
  },
  "minimap": {
    "show": "always"
  },
  "autosave": {
    "after_delay": {
      "milliseconds": 1000
    }
  },
  "icon_theme": {
    "mode": "light",
    "light": "Zed (Default)",
    "dark": "Zed (Default)"
  },
  "base_keymap": "VSCode",
  "ui_font_size": 14.0,
  "buffer_font_size": 14.0,
  "theme": {
    "mode": "dark",
    "light": "One Light",
    "dark": "Transparent Prism" // Change this to "Transparent Prism" or "Dark Violet (Transparent)" whenever you want transparency!
  },
  "agent": {
    "threads_sidebar": {
      "auto_open": false
    }
  },
  "disable_ai": true,
  "project_panel": {
    "dock": "left",
    "default_width": 160
  },

  /* ==========================================================
     THEME OVERRIDES
     ========================================================== */
  "theme_overrides": {

    /* --- 1. ONE DARK THEME (Solid Pitch Black Base) --- */
    "One Dark": {
      "background": "#000000",
      "editor.background": "#000000",
      "editor.gutter.background": "#000000",
      "editor.active_line.background": "#000000",
      "title_bar.background": "#000000",
      "tab_bar.background": "#000000",
      "tab.inactive_background": "#000000",
      "tab.active_background": "#000000",
      "toolbar.background": "#000000",
      "status_bar.background": "#000000",
      "panel.background": "#000000",
      "panel.focused_border": "#000000",
      "terminal.background": "#000000",
      "surface.background": "#000000",
      "elevated_surface.background": "#000000",
      "border.variant": "#000000",
      "border": "#000000",

      "players": [
        {
          "selection": "#ffffff33"
        }
      ],

      "syntax": {
        "comment": { "color": "#8f8f8f" },
        "keyword": { "color": "#ffc799" },
        "function": { "color": "#ffc799" },
        "string": { "color": "#ffc799" },
        "number": { "color": "#ffc799" },
        "boolean": { "color": "#ffc799" },
        "constant": { "color": "#ffc799" },
        "type": { "color": "#ffffff" },
        "variable": { "color": "#ffffff" },
        "property": { "color": "#ffffff" },
        "operator": { "color": "#ffffff" },
        "punctuation": { "color": "#ffffff" },
        "punctuation.bracket": { "color": "#ffffff" },
        "punctuation.delimiter": { "color": "#ffffff" },
        "preproc": { "color": "#ffc799" },
        "attribute": { "color": "#ffffff" }
      },
      "text.accent": "#ffc799",
      "border.focused": "#ffc799",
      "link_text.hover": "#ffc799"
    },

    /* --- 2. TRANSPARENT PRISM THEME [True Window Transparency] --- */
    "Transparent Prism": {
